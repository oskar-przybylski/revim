#!/usr/bin/env bash
# Runs CI checks locally before every `git push`; a failing check aborts the push.
# Enable once per clone:  git config core.hooksPath .githooks
# Skip in an emergency:   git push --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "warning: uncommitted changes — checks run on the working tree, not on the pushed commits" >&2
fi

if ! scripts/ci.sh; then
    echo >&2
    echo "pre-push: CI checks failed, push aborted (fix them or use 'git push --no-verify')" >&2
    exit 1
fi
